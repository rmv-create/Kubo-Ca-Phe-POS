rules_version = '2';

// Who may read and write a shop's records.
//
// Three facts decide everything below.
//
//  * The **owner** is an account — an email and a password she chose, and
//    one the owner has approved. An account that is not approved can be
//    made, because no free setting prevents it, and is worth exactly
//    nothing: it can open no shop and read none. Her
//    uid is written on the shop when she opens it and is never changed, so
//    she can sign in on any phone and still be the owner.
//  * A **till** is a phone she has let in: a document under the shop named
//    after that phone's own sign-in id. A barista's phone signs in
//    anonymously, which proves nothing on its own; what lets it in is the
//    invite.
//  * An **invite** is a document of its own under `invites`, good for ten
//    minutes. It is what a phone holding nothing but a code uses to find
//    the shop. Knowing a shop's id is not a way in.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Who may own a shop. Two lists, and an email on either one is in.
    //
    // The first is written here, as fingerprints rather than addresses.
    // This file lives in a public repository, and an email address in a
    // public repository is an email address in every spam list within the
    // week. A SHA-256 proves "this is the same address" without publishing
    // it. That is a courtesy, not a security measure: what actually keeps
    // the shop hers is her password, and this list only decides who is
    // allowed to try.
    function fingerprinted() {
      return hashing.sha256(request.auth.token.email.lower())
          .toHexString().lower() in [
        // The owner. The address itself is deliberately not written
        // here; she knows it, and so does the account that signs in.
        'a16e07c884966a1c5d1e9af90355f9906cce9bb819b7c2e3b70c98665df3d27c',
      ];
    }

    // The second is a collection she keeps herself, so that approving
    // somebody new never means waiting for a new version of the app. One
    // empty document per approved email, the email *is* the document id,
    // and there is nothing else to store beyond "this person is allowed".
    //
    // No phone can read it and no phone can write it. It is edited in the
    // Firebase console, which answers to the Google account that owns the
    // project and to nothing else. A rule may still consult it, because
    // rules run on the server rather than on anybody's phone.
    function listed() {
      return exists(/databases/$(database)/documents/allowed_owners/$(
        request.auth.token.email.lower()
      ));
    }

    function approved() {
      return signedIn()
        && request.auth.token.email != null
        && (fingerprinted() || listed());
    }

    function shopPath(shopId) {
      return /databases/$(database)/documents/shops/$(shopId);
    }

    function shopExists(shopId) {
      return exists(shopPath(shopId));
    }

    function isOwner(shopId) {
      return signedIn()
        && shopExists(shopId)
        && get(shopPath(shopId)).data.owner_uid == request.auth.uid;
    }

    function isTill(shopId) {
      return signedIn() && exists(
        /databases/$(database)/documents/shops/$(shopId)/tills/$(request.auth.uid)
      );
    }

    function invitePath(code) {
      return /databases/$(database)/documents/invites/$(code);
    }

    // A live invite for this shop, and nothing else, is what admits a phone.
    function inviteAdmits(shopId, code) {
      return code is string
        && exists(invitePath(code))
        && get(invitePath(code)).data.shop_id == shopId
        && request.time < get(invitePath(code)).data.expires_at;
    }

    // An invite says which shop it opens and when it dies. Anybody signed in
    // may read one *if they already know the code* — a get, never a list, so
    // the collection cannot be browsed for live invites. Only the shop's
    // owner may write one, and only pointing at her own shop.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if isOwner(request.resource.data.shop_id)
        && request.resource.data.created_by == request.auth.uid
        && request.resource.data.expires_at is timestamp
        // Ten minutes, with a minute of slack for a slow clock. An invite
        // that lives for a week is a password that was shouted once.
        && request.resource.data.expires_at
             < request.time + duration.value(11, 'm');
      allow delete: if isOwner(resource.data.shop_id);
    }

    // Which shop an account owns. Hers to read, written once when she
    // opens it, and never pointed anywhere else afterwards.
    match /owners/{uid} {
      allow get: if signedIn() && uid == request.auth.uid;
      allow list: if false;
      allow create: if approved() && uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Shut to every client, in both directions. The console is not a client.
    match /allowed_owners/{email} {
      allow read, write: if false;
    }

    match /shops/{shopId} {
      // Opening a shop names its owner, it must be the account doing the
      // opening, and that account must be on the owners list. Anybody can
      // load the page and anybody can make themselves an account; this is
      // the line where that stops being worth anything. Ids are 32 random
      // hex characters, so there is nothing to guess at either.
      allow create: if approved()
        && request.resource.data.owner_uid == request.auth.uid;

      allow get: if isTill(shopId);
      // The owner alone, and she may never hand the shop to somebody else.
      allow update: if isOwner(shopId)
        && request.resource.data.owner_uid == resource.data.owner_uid;
      allow delete: if false;

      // One document per phone, named after that phone's own sign-in id.
      match /tills/{uid} {
        allow read: if isTill(shopId);

        // You may only ever add yourself, and only as the very first till —
        // the owner, before the shop document exists — or by presenting an
        // invite that is live right now.
        // The owner's own first till goes in before the shop document
        // exists, so that one is allowed on the strength of the owners
        // list. Everybody afterwards needs a live invite — which is how a
        // barista gets in without an email or an account of her own.
        allow create: if signedIn()
          && uid == request.auth.uid
          && (
            (!shopExists(shopId) && approved())
            || inviteAdmits(shopId, request.resource.data.code)
          );

        // A phone may say hello as itself. It may not promote itself: the
        // role it joined with is the role it keeps.
        allow update: if isTill(shopId)
          && uid == request.auth.uid
          && request.resource.data.role == resource.data.role;

        // The owner can shut any phone out. A phone can also let itself go.
        allow delete: if isOwner(shopId) || uid == request.auth.uid;
      }

      // The nightly copy of the whole shop, one document per day with the
      // squeezed data split across `parts` underneath it.
      //
      // Any till may write one: a backup that did not happen because the
      // wrong phone closed the day is worse than a backup written by the
      // barista. Only the owner may remove one, so nobody can quietly empty
      // the safe — the pruning of old nights runs on her till.
      match /backups/{day} {
        allow read: if isTill(shopId);
        allow create, update: if isTill(shopId)
          && request.resource.data.parts is int;
        allow delete: if isOwner(shopId);

        match /parts/{index} {
          allow read: if isTill(shopId);
          allow create, update: if isTill(shopId);
          allow delete: if isTill(shopId);
        }
      }

      // The log the tills leave for each other. Append only: a change is
      // written once, by the till it happened on, and nobody — including
      // that till, including the owner — may edit or remove it afterwards.
      // A shop's books should not be rewritable from a phone.
      match /changes/{changeId} {
        allow read: if isTill(shopId);
        allow create: if isTill(shopId)
          && request.resource.data.device_id is string
          && request.resource.data.table is string;
        allow update, delete: if false;
      }
    }
  }
}
